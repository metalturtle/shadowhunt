# Build directories
/build/
/Debug/
/Release/

# Compiled object files
*.o
*.obj
*.lo
*.a
*.la
*.so
*.dylib
*.dll

# Executables (root only: a bare "main" also matched SDL's src/main/)
*.exe
*.out
/hello
/main

# CMake output from in-source configures. Build trees are ignored above; a
# global *.cmake or Makefile rule would also drop vendored build scripts.
CMakeCache.txt
CMakeFiles/
/cmake_install.cmake
/CPackConfig.cmake
/CPackSourceConfig.cmake
/CTestTestfile.cmake
/Makefile
compile_commands.json

# macOS
.DS_Store
*.dSYM/

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Zip archives (unless you need them)
*.zip
.cache
/res

# Extra build trees and Python caches
/build*/
__pycache__/
.play-logs/
