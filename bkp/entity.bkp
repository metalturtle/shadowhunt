cpBody* createCircle(float x, float y, float radius) {
    cpFloat mass = 1.0f;
    cpFloat moment = cpMomentForCircle(mass, 0, radius, cpvzero);
    
    cpBody *body = cpSpaceAddBody(worldId, cpBodyNew(mass, moment));
    cpBodySetPosition(body, cpv(x, y));
    cpBodySetVelocityUpdateFunc(body, cpBodyUpdateVelocity);
    
    cpShape *shape = cpSpaceAddShape(worldId, cpCircleShapeNew(body, radius, cpvzero));
    cpShapeSetFriction(shape, 0.0f);
    cpShapeSetElasticity(shape, 0.0f);
    
    return body;
}

