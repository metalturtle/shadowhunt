int createSpriteFactory(void (*setup
)(VectorEntity *sprite, SaveDataHandler*), void (*think)(VectorEntity *vecEnt, bool isServer, inputCommand_t *inpCmd), void (*cleanup)(VectorEntity *sprite), void (*serializer)(VectorEntity *sprite, NetObj *netObj), void (*puppetSerializer)(VectorEntity *sprite, NetObj *netObj)) {
    SpriteFactory *spriteFactory = &spriteFactoryList[spriteFactoryCount];
    spriteFactory->typeID = spriteFactoryCount;
    spriteFactory->setup = setup;
    spriteFactory->think = think;
    spriteFactory->cleanup = cleanup;
    spriteFactory->serializer = serializer;
    spriteFactory->puppetSerializer = puppetSerializer;

    int initSize = 8;
    // initialize client record list.
    // client record list stores list of client entity record list for each client
    // client entity records store the client state of entities
    // vecinit(GENERALZONE, spriteFactory->clientRecordList, clientEntityRecordList_t, initSize);
    // vecinit(GENERALZONE, spriteFactory->clientBitmap, byte, initSize/8);

    // initialise entity state list.
    // this is for the server to set the state bits that have changed, and should
    // be sent to all clients
    // vecinit(GENERALZONE, spriteFactory->entityStateList, entityStateBitmap_t, initSize);
    // vecinit(GENERALZONE, spriteFactory->entityBitmap, byte, initSize/8);


    // init the entity ID translate map. The server entity IDs
    // are mapped to the client entity IDs
    // spriteFactory->translateIDMap = i2imap_init(GENERALZONE);

    // init the mapping that translates connection id to the
    // location in clientRecordList vector
    // spriteFactory->conIDMap = i2imap_init(GENERALZONE);
    return spriteFactoryCount++;
}

