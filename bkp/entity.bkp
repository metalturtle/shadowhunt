//     b2BodyDef bodyDef = b2DefaultBodyDef();
//     bodyDef.position = (b2Vec2){0.0f, 0.0f};  // Edges use absolute coords
//     b2BodyId wallId = b2CreateBody(worldId, &bodyDef);
    
//     b2Segment segment = {{x1, y1}, {x2, y2}};
//     b2ShapeDef shapeDef = b2DefaultShapeDef();
//     shapeDef.enableContactEvents = true;
//     b2CreateSegmentShape(wallId, &shapeDef, &segment);
// }

void createEdgeWall(float x1, float y1, float x2, float y2) {
    cpBody *staticBody = cpSpaceGetStaticBody(worldId);
    
    cpShape *segment = cpSegmentShapeNew(
        staticBody,
        cpv(x1, y1),
        cpv(x2, y2),
        0.0f  // or 1.0f for slightly thicker collision
    );
    
    cpShapeSetFriction(segment, 0.0f);
    cpShapeSetElasticity(segment, 0.0f);
    
    cpSpaceAddShape(worldId, segment);
}

void createEdgeBoundary(float x, float y, float width, float height) {
    // Bottom
    createEdgeWall(x, y, x + width, y);
    // Right
    createEdgeWall(x + width, y, x + width, y + height);
    // Top
    createEdgeWall(x, y + height, x + width, y + height);
    // Left
    createEdgeWall(x, y, x, y + height);
}


