// create client entity list for each serializer
void ent_handleClientJoin(int conID, serv_clrep_t *newClRep)
{
    clientEntityRecordList_t *clEntRecordList;
    bitstream_t bs;

    clEntRecordList = &newClRep->clientEntRecordList;

